rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all files publicly
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow upload access to authenticated users for any files
    match /businesses/{allPaths=**} {
      allow write: if request.auth != null;
    }
    match /chats/{allPaths=**} {
      allow write: if request.auth != null;
    }
    match /feed/{allPaths=**} {
      allow write: if request.auth != null;
    }
    match /reviews/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
