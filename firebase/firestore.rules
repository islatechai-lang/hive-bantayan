rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if user has specific role
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    // Helper: Check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- USERS COLLECTION ----
    match /users/{userId} {
      allow read, write: if true;

      // Saved Addresses Subcollection
      match /savedAddresses/{addressId} {
        allow read, write: if true;
      }
    }

    // ---- BUSINESSES COLLECTION ----
    match /businesses/{businessId} {
      allow read, write: if true;

      // Products Subcollection
      match /products/{productId} {
        allow read, write: if true;
      }
    }

    // ---- PRODUCTS COLLECTION (Top-level cache if any) ----
    match /products/{productId} {
      allow read, write: if true;
    }

    // ---- ORDERS COLLECTION ----
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // ---- REVIEWS COLLECTION ----
    match /reviews/{reviewId} {
      allow read: if true; // Public access to view reviews
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.businessId == getUserData().businessId || hasRole('admin'));
      allow delete: if hasRole('admin');
    }

    // ---- FEED POSTS COLLECTION ----
    match /feedPosts/{postId} {
      allow read: if true;
      allow write: if isSignedIn() && (hasRole('business') || hasRole('admin'));
    }

    // ---- CHATS COLLECTION ----
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || hasRole('admin'));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || hasRole('admin'));
      allow delete: if hasRole('admin');

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || hasRole('admin'));
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if hasRole('admin');
      }
    }

    // ---- FAVORITES COLLECTION ----
    match /favorites/{favId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ---- REPORTS COLLECTION ----
    match /reports/{reportId} {
      allow read: if hasRole('admin') || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if hasRole('admin');
    }

    // ---- PROMOTIONS COLLECTION ----
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isSignedIn() && (hasRole('business') || hasRole('admin'));
    }

    // ---- ANNOUNCEMENTS COLLECTION ----
    match /announcements/{annId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }
    // ---- SYSTEM CONFIG COLLECTION ----
    match /systemConfig/{docId} {
      allow read, write: if true;
    }
  }
}
